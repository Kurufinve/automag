/.venv
/.idea
__pycache__
*.pyc
.DS_Store
.pytest_cache
.hypothesis
.qoder
.zed

# Pipeline run directories created inside the checkout.
runs/
/build/
/dist/
*.spec

# Third-party codes downloaded and compiled by tools/build_external.py.
/external/

# Example data inside the stage directories is never published: these are
# large calculation outputs (ESpinS runs, MAE scans) that belong to a project,
# not to the code.  vampire_input/ stays - it is the template the Monte Carlo
# stage copies into a project.
/3_monte_carlo/*/
!/3_monte_carlo/vampire_input/
/4_mae/*/

# Work directories created when an example is run in place.
# The examples are meant to be copied somewhere else; nothing they produce
# belongs in the repository.
/examples/*/0_conv/
/examples/*/1_lin_response/
/examples/*/2_coll/
/examples/*/2_relax/
/examples/*/3_monte_carlo/
/examples/*/4_mae/
/examples/*/CalcFold/
/examples/*/geometries/
/models/*
# The checkpoints themselves stay out of git; this note describes how to get them.
!/models/README.md
